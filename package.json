{
  "name": "node-yss",
  "version": "0.19.990",
  "description": "Yss from oiyshTerminal in nodejs.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prebuild": "./mkPrebuild.sh",
    "mkPackage": "npm pack",
    "postpack": "cp './'$npm_package_name'-'$npm_package_version'.tgz' './'$npm_package_name'-latest.tgz' ;exit 0",

    "mkBackup": "fn=$npm_package_name\"_v\"$npm_package_version\"_tt\"`date +%y%m%d%H%M%S`\".tar.bz2\"; echo \"name will be [$fn]\";  tar --exclude=\".git\" --exclude=\"node_modules\" -cvf \"../\"$fn ./; echo \"Backup done: [$fn]\"; ls -alh ../$fn"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yOyOeK1/node-yss.git"
  },
  "keywords": [
    "oiyshTerminal",
    "ot",
    "yss"
  ],
  "author": "Bartlomiej Ceglik <yoyoek@wp.pl>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yOyOeK1/node-yss/issues"
  },
  "homepage": "https://github.com/yOyOeK1/node-yss#readme"
}
